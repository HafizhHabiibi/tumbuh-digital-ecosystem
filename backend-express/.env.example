# =========================================================
# Database — wajib
# =========================================================
DB_HOST=localhost
DB_USER=root
DB_NAME=posyandu_pui
DB_PASSWORD=
DB_PORT=3306

# =========================================================
# Authentication — wajib, minimal 32 karakter dan harus berbeda
# Jangan gunakan nilai contoh ini di production
# =========================================================
JWT_SECRET=change_me_jwt_secret_minimum_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_minimum_32_chars

# =========================================================
# Frontend dan CORS — wajib
# =========================================================
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# =========================================================
# Cloudflare Turnstile
# Opsional di development, wajib di production
# Test secret Cloudflare:
# 1x0000000000000000000000000000000AA
# =========================================================
TURNSTILE_SECRET_KEY=

# =========================================================
# Email reset password
# Wajib jika fitur lupa password akan digunakan
# Untuk Gmail gunakan App Password, bukan password akun biasa
# =========================================================
MAIL_USER=
MAIL_PASS=

# =========================================================
# Gemini API
# Wajib agar readiness lulus dan fitur insight/chat AI dapat digunakan
# GEMINI_API_KEYS dapat berisi beberapa key dipisahkan koma
# =========================================================
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_RETRIES=2
GEMINI_KEY_COOLDOWN_MS=60000
GEMINI_MAX_BACKOFF_MS=4000

# =========================================================
# Chat rate limit
# =========================================================
CHAT_RATE_LIMIT_WINDOW_MS=300000
CHAT_RATE_LIMIT_MAX=10

# =========================================================
# Firebase Cloud Messaging — pilih salah satu metode
# =========================================================

# Opsi 1: service-account JSON dalam format Base64
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Opsi 2: Application Default Credentials
FIREBASE_USE_APPLICATION_DEFAULT=false
GOOGLE_APPLICATION_CREDENTIALS=

# =========================================================
# Application
# =========================================================
PORT=3000
NODE_ENV=development

# Identitas fasilitas pada laporan PDF
NAMA_POSYANDU=Posyandu Melati
NAMA_PUSKESMAS=Puskesmas Kecamatan

# 0: aplikasi diakses langsung
# 1: aplikasi berada tepat di belakang satu reverse proxy
TRUST_PROXY_HOPS=0
