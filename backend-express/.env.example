# Database
DB_HOST=localhost
DB_USER=root
DB_NAME=your_database_name
DB_PASSWORD=
DB_PORT=3306

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# FrontEnd
FRONTEND_URL=http://localhost:5173

# Email (Gmail SMTP)
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_email_password
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Firebase (pilih salah satu)
# Opsi 1: service-account JSON yang sudah di-base64 (jangan commit nilainya)
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Opsi 2: Application Default Credentials / GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_USE_APPLICATION_DEFAULT=false

# App
PORT=3000
NODE_ENV=development
# Identitas fasilitas untuk header laporan (sistem satu Posyandu/Puskesmas)
NAMA_POSYANDU=Posyandu Melati
NAMA_PUSKESMAS=Puskesmas Kecamatan
# 0 jika aplikasi diakses langsung, 1 jika tepat di belakang satu reverse proxy
TRUST_PROXY_HOPS=0
